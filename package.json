{
  "name": "quire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free PDF editor, converter and form library that runs entirely in the browser.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node --experimental-strip-types tools/build.mjs && vite build",
    "site": "node --experimental-strip-types tools/build.mjs",
    "check": "node tools/check.mjs && tsc --noEmit",
    "serve": "vite preview --outDir . --port 5191",
    "previews": "node --experimental-strip-types tools/build-previews.mjs --force",
    "og": "node tools/og-card.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "utif": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
